{
  "encoding": {
    "order": "F 面顶行从左到右，再读 R 面顶行从左到右；角、棱、角｜角、棱、角。",
    "normalization": "沿 F→R→B→L 循环统一替换颜色，使首字符为 F，保留相邻色、相对色与方向关系。",
    "oppositePairs": [
      "FB",
      "RL"
    ],
    "views": "从公式库的贴纸状态读取 U 层四个方向，每个 PLL 内按归一化编码去重。",
    "tagPolicy": "记录所有满足的标签。色块限同一面；2×1 色块要求第三格颜色不同，三格同色内部的两格不计入。车灯要求同一面两端角贴同色且中间棱贴颜色不同，三格同色那一面不计入；另一面若有独立的两格块或车灯，仍保留对应标签。棋盘检查六格中的连续子串，只保留最长棋盘对应的标签。角块归位允许整体 AUF。",
    "source": "src/data/formulas/pll.json",
    "reference": "https://sarah.cubing.net/3x3x3/pll-recognition-guide"
  },
  "tags": [
    {
      "id": "headlight",
      "label": "车灯",
      "description": "同一面两端角贴同色，中间棱贴颜色不同；三格同色那一面不计入车灯。",
      "group": "pattern"
    },
    {
      "id": "bookend",
      "label": "书挡",
      "description": "六格最左与最右的角贴同色。",
      "group": "pattern"
    },
    {
      "id": "block-2",
      "label": "2×1 色块",
      "description": "同一面恰有连续两格同色，第三格颜色不同；三格同色内部的两格不计入。",
      "group": "pattern"
    },
    {
      "id": "block-3",
      "label": "3×1 色块",
      "description": "同一面的三格全部同色。",
      "group": "pattern"
    },
    {
      "id": "checker-4",
      "label": "4 格棋盘",
      "description": "最长的连续双色交替片段为四格，可跨越两面接缝。",
      "group": "pattern"
    },
    {
      "id": "checker-5",
      "label": "5 格棋盘",
      "description": "最长的连续双色交替片段为五格，不再标注 4 格棋盘。",
      "group": "pattern"
    },
    {
      "id": "checker-6",
      "label": "6 格棋盘",
      "description": "六格由两种不同颜色连续交替组成，不再标注 4 格和 5 格棋盘。",
      "group": "pattern"
    },
    {
      "id": "colors-2",
      "label": "2 种颜色",
      "description": "全部六格恰好有两种颜色。",
      "group": "colors"
    },
    {
      "id": "colors-3",
      "label": "3 种颜色",
      "description": "全部六格恰好有三种颜色。",
      "group": "colors"
    },
    {
      "id": "colors-4",
      "label": "4 种颜色",
      "description": "全部六格恰好有四种颜色。",
      "group": "colors"
    },
    {
      "id": "epll",
      "label": "EPLL · 角块归位",
      "description": "四个角块的相对位置正确，允许整体差一个 U 层调整；包含 PLL skip。",
      "group": "corners"
    },
    {
      "id": "diag-cp",
      "label": "Diag CP · 对角换角",
      "description": "调整 U 层后，需要交换一对对角的角块。",
      "group": "corners"
    },
    {
      "id": "adj-cp",
      "label": "Adj CP · 邻角换角",
      "description": "调整 U 层后，需要交换一对相邻的角块。",
      "group": "corners"
    }
  ],
